{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile-default",
  "description": "Android capability (HTTP via Rust plugin)",
  "platforms": ["android"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" },
        { "url": "http://*:*" },
        { "url": "https://*:*" }
      ]
    }
  ]
}
