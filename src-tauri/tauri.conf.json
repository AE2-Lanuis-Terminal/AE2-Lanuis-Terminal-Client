{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AE2 Lanuis Terminal",
  "version": "0.1.0",
  "identifier": "com.lanuis.ae2web.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AE2 Lanuis Terminal",
        "width": 460,
        "height": 640,
        "minWidth": 420,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "backgroundColor": "#151a22",
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
